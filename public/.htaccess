# =========================================================================
# CONFIGURAÇÃO DE SERVIDOR APACHE / CPANEL - DATA WAREHOUSE ELEITORAL
# =========================================================================

# 1. Configurações de Limite de Upload para Arquivos CSV Grandes (+100MB)
<IfModule mod_php7.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 100M
  php_value memory_limit 512M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

<IfModule mod_php.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 100M
  php_value memory_limit 512M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_flag display_errors Off
  php_flag log_errors On
</IfModule>

# 2. Segurança: Bloqueio de Arquivos Sensíveis
<FilesMatch "\.(sql|sqlite|log|ini|md)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# 3. Habilita Compressão GZIP para Alta Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/javascript
</IfModule>

# 4. Habilita Cache de Arquivos Estáticos (CSS, JS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 5. Charset Padrão UTF-8
AddDefaultCharset UTF-8
